+    cv2.imwrite(str(ref_512_path), ref_512)
+    cv2.imwrite(str(mask_512_path), mask_512)
+
+    # 4. AnyText2 Server Model Execution
+    print(f"\n[Step 3] Initializing AnyText2 Model...")
